{
  "name": "interview-copilot",
  "productName": "Interview Copilot",
  "version": "1.0.0",
  "description": "A lightweight Mac menu bar app that records audio from video interviews, transcribes them, and provides readable transcripts with speaker labels.",
  "main": "dist/main/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "start": "electron .",
    "test": "jest --verbose",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.interview-copilot.app",
    "productName": "Interview Copilot",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "src/assets/icon.png",
      "target": "dmg"
    },
    "directories": {
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron": "^43.1.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
