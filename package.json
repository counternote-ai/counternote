{
  "name": "counternote",
  "productName": "CounterNote",
  "version": "1.0.0",
  "description": "A private, local-first meeting companion that records audio and creates timestamped transcripts.",
  "main": "dist/main/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "start": "electron .",
    "test": "jest --verbose",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "build:whisper": "bash scripts/build-whisper-sidecar.sh",
    "verify:whisper": "bash scripts/verify-whisper-sidecar.sh build/whisper/darwin-arm64/whisper-cli",
    "build:capture": "bash scripts/build-audio-capture-sidecar.sh",
    "verify:capture": "bash scripts/verify-audio-capture-sidecar.sh build/audio-capture/darwin-arm64/counternote-audio-capture",
    "verify:capture:release": "bash scripts/verify-audio-capture-signing.sh \"release/mac-arm64/CounterNote.app\" signed-release",
    "pack": "npm run build:whisper && npm run verify:whisper && npm run build:capture && npm run verify:capture && CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --arm64",
    "pack:release": "npm run build:whisper && npm run verify:whisper && npm run build:capture && npm run verify:capture && npm run build && electron-builder --dir --arm64",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "check:pack": "npm run pack && bash scripts/verify-whisper-sidecar.sh \"release/mac-arm64/CounterNote.app/Contents/Resources/whisper/bin/whisper-cli\" && bash scripts/verify-audio-capture-sidecar.sh \"release/mac-arm64/CounterNote.app/Contents/Resources/audio-capture/bin/counternote-audio-capture\" && npm run test:packaged"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/postcss": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.23.0",
    "postcss": "^8.5.16",
    "postcss-loader": "^8.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.13.0",
    "css-loader": "^7.1.4",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
